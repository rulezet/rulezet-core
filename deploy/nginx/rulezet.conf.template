# Rulezet — nginx reverse proxy.
# GENERATED by deploy/setup_nginx.sh from deploy/nginx/rulezet.conf.template.
# Edit the template and re-run the script rather than editing this file.
#
#   internet → (upstream proxy, if any) → nginx :80 ─┬─ /api/  → gunicorn "api"  127.0.0.1:__API_PORT__
#                                                     └─ rest   → gunicorn "site" 127.0.0.1:__SITE_PORT__

# ── Rate limiting (per client IP) ───────────────────────────────────────────
# IPs in /etc/nginx/rulezet-allowlist.conf ("203.0.113.7 1;") are never limited.
geo $rz_allowlisted {
    default 0;
    include /etc/nginx/rulezet-allowlist.conf;
}
map $rz_allowlisted $rz_limit_key {
    1       "";
    default $binary_remote_addr;
}
limit_req_zone $rz_limit_key zone=rz_site:20m rate=__SITE_RATE__;
limit_req_zone $rz_limit_key zone=rz_api:20m  rate=__API_RATE__;
limit_req_status 429;
limit_req_log_level warn;

# Access log with the response time ($request_time, seconds) — to spot slow pages.
log_format rz_timed '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                    '$request_time "$http_user_agent"';

# ── Caching (docs/future/caching.md) ───────────────────────────────────────
# Micro-cache: anonymous GET pages / public API answers kept 60 s, so crawlers, AI agents and
# many visitors on the same rule page cost one Python render per minute instead of one per hit.
# Never cached: a request with a session / remember cookie, an API key or an Authorization header;
# a response with Set-Cookie (so any page that touches the session, e.g. a form with a CSRF token)
# or with Cache-Control private / no-store (the app sends "private" for every signed-in answer).
proxy_cache_path /var/cache/nginx/rulezet levels=1:2 keys_zone=rz_cache:50m max_size=1g inactive=10m use_temp_path=off;
map $http_cookie $rz_cookie_bypass {
    default 0;
    "~*(^|;\s*)(__SESSION_COOKIE__|remember_token)=" 1;
}
map "$rz_cookie_bypass$http_x_api_key$http_authorization" $rz_cache_bypass {
    "0"     0;
    default 1;
}
# Versioned static URLs (?v=<mtime>, app/core/utils/static_versions.py) never change: one year.
map $arg_v $rz_static_cache {
    ""      "public, max-age=3600";
    default "public, max-age=31536000, immutable";
}

upstream rulezet_site { server 127.0.0.1:__SITE_PORT__; keepalive 16; }
upstream rulezet_api  { server 127.0.0.1:__API_PORT__;  keepalive 16; }

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __SERVER_NAME__;

__REAL_IP__
    # Rulezet has no upload size limit of its own (rule/bundle imports) —
    # nginx's default (1 MB) would break them.
    client_max_body_size 200m;

    # Compression in the server block: Debian's nginx.conf already sets "gzip on;" at http level
    # (a second one there = "gzip directive is duplicate", nginx refuses the whole config)
    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript text/javascript application/json text/plain text/xml application/xml image/svg+xml;

    access_log /var/log/nginx/rulezet-site.access.log rz_timed;
    error_log  /var/log/nginx/rulezet.error.log warn;

    # "Rulezet is being updated" page while it restarts (deploy/nginx/maintenance.conf)
    include /etc/nginx/snippets/rulezet-maintenance.conf;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
__FORWARD_HEADERS__
    proxy_connect_timeout 10s;
    proxy_read_timeout    180s;   # > gunicorn's 120 s timeout
    proxy_send_timeout    180s;

    # Micro-cache for every proxied location below (static files are read from disk)
    proxy_cache rz_cache;
    # Every header the app builds links from is in the key (ProxyFix trusts X-Forwarded-Host / -Proto):
    # a forged X-Forwarded-Host can never put its links into the page everybody else gets.
    proxy_cache_key "$scheme|$request_method|$host|$http_x_forwarded_host|$http_x_forwarded_proto|$request_uri";
    proxy_cache_valid 200 301 302 60s;
    proxy_cache_valid 404 10s;
    proxy_cache_bypass $rz_cache_bypass;
    proxy_no_cache     $rz_cache_bypass;
    proxy_cache_lock on;                                          # 100 hits on a cold page = 1 render
    proxy_cache_use_stale updating error timeout http_502 http_503 http_504;   # also covers restarts
    proxy_cache_background_update on;
    add_header X-Cache-Status $upstream_cache_status always;

    # JS/CSS/images: served by nginx straight from disk (no Python thread), never rate-limited.
    # A file nginx cannot read (permissions, generated later…) falls back to the app.
    # Same security headers as the app sends (app/__init__.py set_security_headers).
    location /static/ {
        root __APP_DIR__;
        try_files $uri @rulezet_static;
        add_header Cache-Control $rz_static_cache always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        access_log off;
    }
    # Files people upload (avatars, blog images…): a sandbox, so an uploaded SVG / HTML can never run a script
    location /static/uploads/ {
        root __APP_DIR__;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox; frame-ancestors 'self'" always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        access_log off;
    }
    # No dotfile is ever served from static (.gitkeep, editor leftovers…)
    location ~ ^/static/(.*/)?\. {
        return 404;
    }
    location @rulezet_static {
        proxy_cache off;
        proxy_pass http://rulezet_site;
    }

    # CVE → rules lookup, called heavily by the vulnerability-lookup tool: NEVER rate-limited
    # (no limit_req here, whatever the dry-run state). Same backend, same answer format.
    location = /api/rule/public/search_rules_by_cve {
        access_log /var/log/nginx/rulezet-api.access.log rz_timed;
        proxy_pass http://rulezet_api;
    }

    # REST API → its own gunicorn process and its own log.
    location /api/ {
        access_log /var/log/nginx/rulezet-api.access.log rz_timed;
        limit_req zone=rz_api burst=__API_BURST__ nodelay;
        limit_req_dry_run __DRY_RUN__;
        proxy_pass http://rulezet_api;
    }

    location / {
        limit_req zone=rz_site burst=__SITE_BURST__ nodelay;
        limit_req_dry_run __DRY_RUN__;
        proxy_pass http://rulezet_site;
    }
}
