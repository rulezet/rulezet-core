{
  "label": "Workflow templates",
  "category": "Workflows",
  "description": "Ready-made workflows of Admin → Workflows → Templates. One entry per template: label, icon (Font Awesome), description, spec (the workflow: title, description, tasks — the same JSON as a workflow exported from the Workflows page). \"Save as template\" on a workflow adds one here. A template's first task is created paused.",
  "public": false,
  "value": {
    "weekly_maintenance": {
      "label": "Weekly maintenance",
      "icon": "fa-solid fa-screwdriver-wrench",
      "description": "Every Sunday night: pull the git clones, resync Git Sources, look again for links between rules, try the bad rules again, re-read references & metadata, recompute the leaderboard, clear the caches, then re-scores the rules and the Git sources.",
      "spec": {
        "title": "Weekly maintenance",
        "description": "Keeps rules, links, metadata and figures fresh — every Sunday at 02:00 UTC.",
        "tasks": [
          {
            "ref": "pull",
            "title": "Pull the git clones",
            "task_type": "git_cache_pull",
            "trigger": {
              "trigger_mode": "weekly",
              "days_of_week": [
                6
              ],
              "hour": 2,
              "minute": 0,
              "timezone": "UTC"
            }
          },
          {
            "ref": "resync",
            "title": "Resync Git Sources",
            "task_type": "github_repo_resync",
            "trigger": {
              "after": "pull",
              "condition": "always"
            }
          },
          {
            "ref": "relink",
            "title": "Links between rules",
            "task_type": "relink_rules",
            "target_payload": {
              "formats": [
                "wazuh",
                "kunai"
              ]
            },
            "trigger": {
              "after": "resync",
              "condition": "always"
            }
          },
          {
            "ref": "bad",
            "title": "Bad rules — retry & link",
            "task_type": "bad_rules_retry",
            "target_payload": {
              "formats": [
                "yara"
              ],
              "link_dependencies": true
            },
            "trigger": {
              "after": "relink",
              "condition": "always"
            }
          },
          {
            "ref": "meta",
            "title": "References & metadata",
            "task_type": "reparse_rule_metadata",
            "target_payload": {
              "formats": ""
            },
            "trigger": {
              "after": "bad",
              "condition": "always"
            }
          },
          {
            "ref": "points",
            "title": "Recompute the leaderboard",
            "task_type": "gamification_recompute",
            "trigger": {
              "after": "meta",
              "condition": "always"
            }
          },
          {
            "ref": "quality",
            "title": "Rule quality scores",
            "task_type": "quality_score",
            "trigger": {
              "after": "points",
              "condition": "always"
            }
          },
          {
            "ref": "repos",
            "title": "Git source scores",
            "task_type": "repo_quality",
            "target_payload": {
              "scope": "all"
            },
            "trigger": {
              "after": "quality",
              "condition": "always"
            }
          },
          {
            "ref": "cache",
            "title": "Clear the caches",
            "task_type": "clear_caches",
            "trigger": {
              "after": "repos",
              "condition": "always"
            }
          }
        ]
      }
    },
    "bad_rules_cleanup": {
      "label": "Bad rules clean-up",
      "icon": "fa-solid fa-broom",
      "description": "Every day: try every bad rule again (YARA rules naming another rule are imported linked to it), look again for links, clear the caches.",
      "spec": {
        "title": "Bad rules clean-up",
        "description": "Imports the bad rules that became valid — every day at 04:00 UTC.",
        "tasks": [
          {
            "ref": "bad",
            "title": "Bad rules — retry & link",
            "task_type": "bad_rules_retry",
            "target_payload": {
              "formats": [],
              "link_dependencies": true
            },
            "trigger": {
              "trigger_mode": "daily",
              "hour": 4,
              "minute": 0,
              "timezone": "UTC"
            }
          },
          {
            "ref": "relink",
            "title": "Links between rules",
            "task_type": "relink_rules",
            "target_payload": {
              "formats": [
                "wazuh",
                "kunai",
                "yara"
              ]
            },
            "trigger": {
              "after": "bad",
              "condition": "success"
            }
          },
          {
            "ref": "cache",
            "title": "Clear the caches",
            "task_type": "clear_caches",
            "trigger": {
              "after": "relink",
              "condition": "always"
            }
          }
        ]
      }
    },
    "threat_intel_refresh": {
