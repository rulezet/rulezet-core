              "after": "attack",
              "condition": "always"
            }
          }
        ]
      }
    },
    "nightly_backup": {
      "label": "Nightly backup",
      "icon": "fa-solid fa-database",
      "description": "Every night: a new database backup, checked, then the oldest automatic backups are deleted so the last 10 remain (never fewer than 3). If it fails, nothing is deleted and admins are alerted.",
      "spec": {
        "title": "Nightly backup",
        "description": "A database backup every night at 01:00 UTC.",
        "tasks": [
          {
            "ref": "backup",
            "title": "Backup + keep the last 10",
            "task_type": "db_backup_rotate",
            "trigger": {
              "trigger_mode": "daily",
              "hour": 1,
              "minute": 0,
              "timezone": "UTC"
            },
            "target_payload": {
              "keep": "10"
            }
          }
        ]
      }
    },
    "data_sources_refresh": {
      "label": "Data sources refresh",
      "icon": "fa-solid fa-code-branch",
      "description": "Every 1st of the month: pull the latest MISP taxonomies & galaxies, load them, update MITRE ATT&CK, clear the caches.",
      "spec": {
        "title": "Data sources refresh",
        "description": "MISP and ATT&CK sources pulled and loaded — the 1st of every month at 03:00 UTC.",
        "tasks": [
          {
            "ref": "pull",
            "title": "Pull MISP taxonomies & galaxies",
            "task_type": "submodules_update",
            "target_payload": {
              "names": [
                "misp-taxonomies",
                "misp-galaxy"
              ]
            },
            "trigger": {
              "trigger_mode": "monthly",
              "day_of_month": 1,
              "hour": 3,
              "minute": 0,
              "timezone": "UTC"
            }
          },
          {
            "ref": "misp",
            "title": "Load MISP taxonomies & galaxies",
            "task_type": "misp_update_data",
            "trigger": {
              "after": "pull",
              "condition": "success"
            }
          },
          {
            "ref": "attack",
            "title": "Update MITRE ATT&CK data",
            "task_type": "attack_update_data",
            "trigger": {
              "after": "misp",
              "condition": "always"
            }
          },
          {
            "ref": "cache",
            "title": "Clear the caches",
            "task_type": "clear_caches",
            "trigger": {
              "after": "attack",
              "condition": "always"
            }
          }
        ]
      }
    },
