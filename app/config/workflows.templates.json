    "unverified_accounts_cleanup": {
      "label": "Unverified accounts clean-up",
      "icon": "fa-solid fa-user-xmark",
      "description": "Every evening: a database backup first (checked), then — only if it succeeded — delete the accounts whose email was never verified (sign-up bots, abandoned sign-ups): local sign-ups older than 24 h; never an admin, the Rulezet Official account or the account running it; never more than 200 at once. What they made goes to the admin; their sign-up logs become private.",
      "spec": {
        "title": "Unverified accounts clean-up",
        "description": "Sign-up bots and abandoned sign-ups, every evening at 23:30, after a backup. Run it once by hand with Dry run checked to see what it finds.",
        "tasks": [
          {
            "ref": "backup",
            "title": "Backup first (checked)",
            "task_type": "db_backup_rotate",
            "trigger": {
              "trigger_mode": "daily",
              "hour": 23,
              "minute": 30,
              "timezone": "Europe/Luxembourg"
            },
            "target_payload": {
              "keep": "14"
            }
          },
          {
            "ref": "purge",
            "title": "Delete the accounts with an unverified email",
            "task_type": "purge_unverified_users",
            "trigger": {
              "after": "backup",
              "condition": "success"
            },
            "target_payload": {
              "dry_run": false,
              "grace_hours": 24,
              "max_per_run": 200
            }
          }
        ]
      }
