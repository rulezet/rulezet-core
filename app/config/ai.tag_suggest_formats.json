                {"label": "macOS", "pattern": "product:\\s*macos", "tags": ["ms-caro-malware:malware-platform=\"MacOS\""]},
                {"label": "Process creation", "pattern": "category:\\s*process_(creation|access|tampering)|EventID:\\s*(4688|1)\\b", "tags": ["misp-galaxy:mitre-data-source=\"Process - DS0009\""]},
