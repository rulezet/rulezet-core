{
    "label": "Tag suggestions — context per rule format",
    "category": "AI",
    "description": "What a rule of each Rulezet format detects, so Tag Suggestions also proposes GENERIC but correct tags (file type, platform, data source, incident category, kill-chain phase), not only the names found in the rule. Per format (lower-case key, as in rule.format): context — one or two sentences given to the AI; tags — exact tag names that fit every rule of the format; signals — {label, pattern (case-insensitive regex on title + description + content), tags} that add tags when the rule matches. Unknown tag names are skipped (the admin page lists them). A bundle uses the context of the format most of its rules have.",
    "public": false,
    "value": {
        "yara": {
            "context": "YARA matches files or memory with byte / string patterns and a condition: it identifies a malware family, a tool, a packer or a file type at rest or in memory.",
            "tags": ["misp-galaxy:mitre-data-source=\"File - DS0022\""],
            "signals": [
                {"label": "PE file", "pattern": "uint16\\(0\\)\\s*==\\s*0x5a4d|pe\\.is_pe|pe\\.(imports|exports|sections|number_of_sections|entry_point)|import\\s+\"pe\"", "tags": ["file-type:type=\"peexe\"", "ms-caro-malware:malware-platform=\"Win32\""]},
                {"label": "PE DLL", "pattern": "pe\\.is_dll|pe\\.characteristics\\s*&\\s*pe\\.dll", "tags": ["file-type:type=\"pedll\""]},
                {"label": "64-bit PE", "pattern": "pe\\.is_64bit|pe\\.machine\\s*==\\s*pe\\.machine_amd64", "tags": ["file-type:type=\"peexe64\"", "ms-caro-malware:malware-platform=\"Win64\""]},
                {"label": ".NET", "pattern": "import\\s+\"dotnet\"|dotnet\\.|mscoree\\.dll|_CorExeMain", "tags": ["ms-caro-malware:malware-platform=\"MSIL\""]},
                {"label": "ELF file", "pattern": "uint32\\(0\\)\\s*==\\s*0x464c457f|import\\s+\"elf\"|elf\\.(type|machine|number_of_sections)", "tags": ["file-type:type=\"elf\"", "ms-caro-malware:malware-platform=\"Linux\""]},
                {"label": "Mach-O file", "pattern": "uint32\\(0\\)\\s*==\\s*0x(feedfacf|feedface|cefaedfe|cffaedfe|cafebabe)|import\\s+\"macho\"", "tags": ["file-type:type=\"macho\"", "ms-caro-malware:malware-platform=\"MacOS\""]},
                {"label": "PDF", "pattern": "%PDF|uint32\\(0\\)\\s*==\\s*0x46445025", "tags": ["file-type:type=\"pdf\""]},
                {"label": "Office / OLE", "pattern": "d0\\s*cf\\s*11\\s*e0|0xe011cfd0|\\bvbaProject\\b|word/document\\.xml|\\bAutoOpen\\b|Document_Open", "tags": ["file-type:type=\"doc\""]},
                {"label": "RTF", "pattern": "\\{\\\\rtf|0x74725c7b", "tags": ["file-type:type=\"rtf\""]},
                {"label": "LNK", "pattern": "uint32\\(0\\)\\s*==\\s*0x0000004c|\\.lnk\\b", "tags": ["file-type:type=\"lnk\""]},
                {"label": "PowerShell", "pattern": "powershell|invoke-expression|\\biex\\b|frombase64string|-encodedcommand", "tags": ["file-type:type=\"script\"", "misp-galaxy:mitre-data-source=\"Script - DS0012\""]},
                {"label": "JavaScript", "pattern": "\\beval\\s*\\(|document\\.write|activexobject|wscript\\.shell", "tags": ["ms-caro-malware:malware-platform=\"JS\""]},
                {"label": "VBScript", "pattern": "createobject\\s*\\(|\\.vbs\\b|vbscript", "tags": ["file-type:type=\"vbs\"", "ms-caro-malware:malware-platform=\"VBS\""]},
                {"label": "Android", "pattern": "classes\\.dex|androidmanifest|import\\s+\"dex\"|\\bdex\\.", "tags": ["ms-caro-malware:malware-platform=\"AndroidOS\""]},
                {"label": "Shell script", "pattern": "#!/bin/(ba)?sh|/bin/sh -c|chmod \\+x", "tags": ["file-type:type=\"shell\""]}
            ]
        },
        "sigma": {
            "context": "Sigma is a generic signature for log events (SIEM): its logsource (product / category / service) says which logs it reads, and its detection which event values reveal an attacker technique on an endpoint, a server or a cloud service.",
            "tags": [],
            "signals": [
                {"label": "Windows", "pattern": "product:\\s*windows", "tags": ["ms-caro-malware:malware-platform=\"Win32\""]},
