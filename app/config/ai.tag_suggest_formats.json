                {"label": "Registry", "pattern": "category:\\s*registry_|TargetObject|HKLM\\\\|HKCU\\\\", "tags": ["misp-galaxy:mitre-data-source=\"Windows Registry - DS0024\""]},
                {"label": "File events", "pattern": "category:\\s*file_", "tags": ["misp-galaxy:mitre-data-source=\"File - DS0022\""]},
                {"label": "Network", "pattern": "category:\\s*(network_connection|firewall|proxy|dns)|DestinationIp|DestinationPort", "tags": ["misp-galaxy:mitre-data-source=\"Network Traffic - DS0029\""]},
                {"label": "DNS", "pattern": "category:\\s*dns|service:\\s*dns|QueryName", "tags": ["misp-galaxy:mitre-data-source=\"Domain Name - DS0038\""]},
                {"label": "PowerShell", "pattern": "service:\\s*powershell|category:\\s*ps_|ScriptBlockText", "tags": ["misp-galaxy:mitre-data-source=\"Script - DS0012\""]},
                {"label": "Logon", "pattern": "EventID:\\s*(4624|4625|4648|4672)\\b|LogonType", "tags": ["misp-galaxy:mitre-data-source=\"Logon Session - DS0028\""]},
                {"label": "Active Directory", "pattern": "EventID:\\s*(4662|5136|4769|4768)\\b|service:\\s*security", "tags": ["misp-galaxy:mitre-data-source=\"Active Directory - DS0026\""]},
