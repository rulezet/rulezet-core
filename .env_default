# ─────────────────────────────────────────────────────────────
#  Rulezet — environment variables template
#  Copy this file to .env and fill in the values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-very-secret-key-here

# ── Server binding ────────────────────────────────────────────
# Host and port the Flask dev server / gunicorn listens on.
# Default: 127.0.0.1:7009
#FLASK_URL=127.0.0.1
#FLASK_PORT=7009

# ── Public URL (optional) ─────────────────────────────────────
# The URL your instance is reachable at from the internet.
# Used in telemetry pings so the community registry shows the right address.
# If unset, http://FLASK_URL:FLASK_PORT is used.
#INSTANCE_PUBLIC_URL=https://myinstance.example.com

# ── Behind a reverse proxy? (optional) ──────────────────────────
# Set this to the number of reverse proxies (nginx, ...) in front of this
# instance so Werkzeug's ProxyFix trusts X-Forwarded-For/-Proto/-Host that
# far — request.remote_addr, the activity log's IP column, and the dev
# server's own terminal access log then show the REAL client IP instead of
# the proxy's. Leave unset (0) if this instance is reachable directly (no
# proxy) — trusting these headers with no real proxy in front lets any
# client fake its own IP. Typical single-nginx setup: 1.
#TRUSTED_PROXY_COUNT=1

# ── Suricata deep validation (optional) ─────────────────────────
# Path to a real `suricata` binary (e.g. /usr/bin/suricata). Enables
# "Deep validate" on Suricata rules — a real engine run via
# suricata-language-server, on top of the always-on grammar-only check.
# Off by default: this app never shells out to a real engine unless you
# opt in here. Also requires the suricata-language-server pip package
# installed separately in this app's environment:
#   pip install suricata-language-server
# See docs/design/suricata_language_server_integration.md for the full
# feasibility writeup (including why this is opt-in/per-rule, not run
# automatically on every upload — a full-corpus pass is genuinely slow).
#SURICATA_BINARY_PATH=/usr/bin/suricata

# If custom externals are used in yara rules, add them here in order to
# include them in the validation step, otherwise validation will fail
#YARA_ADDITIONAL_EXTERNAL=package,another_external

# ── Rule Validation source URL (optional) ──────────────────────
# Where the "Rule Validation" background job fetches this instance's own
# rules from. Defaults to INSTANCE_PUBLIC_URL. Set this separately if your
# instance IS its public URL (e.g. this is rulezet.org itself) and the
# server can't route to its own public IP from inside itself ("hairpin
# NAT" — unsupported by many cloud/VPS providers, shows up as the job
# failing with "no route to host"). Point it at a loopback/internal
# address instead, e.g. the port Flask/gunicorn actually listens on:
#RULE_VALIDATION_URL=http://127.0.0.1:7009

# ── MISP → STIX conversion endpoint (optional) ─────────────────
# API used to convert MISP objects to STIX when viewing a rule's STIX
# representation. Defaults to the public cti-transmute.org. Override to
# point at a mirror or self-hosted deployment.
#CTI_TRANSMUTE_URL=https://cti-transmute.org/api/convert/misp_to_stix

# ── Email (optional — needed for account verification) ────────
#MAIL_SERVER=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USE_TLS=true
#MAIL_USE_SSL=false
#MAIL_USERNAME=your-email@gmail.com
#MAIL_PASSWORD=your-app-password
#MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── GitHub API token (optional) ────────────────────────────────
# Personal access token used for GitHub API calls: fetching branches on
# rule import, and filing admin-proposed issues from comments.
# Needs "repo" scope (classic PAT) or "Issues: read/write" (fine-grained,
# scoped to the target repo). Generate at https://github.com/settings/tokens
# Can also be set from the app: Admin → Server Settings → Security.
#GITHUB_TOKEN=ghp_your-token-here

# ── Custom GitHub host (optional) ──────────────────────────────
# Hostname that "Import from GitHub" treats as GitHub. Defaults to github.com.
# Set this to point rule import at a self-hosted GitHub Enterprise Server
# instance or an offline/local mirror instead — useful for an offline Rulezet
# instance that has no route to the public internet. The configured host's
# API must be reachable at https://<host>/api/v3 (GitHub Enterprise Server
# convention) and repo URLs must look like https://<host>/owner/repo.
# Can also be set from the app: Admin → Server Settings → Security.
#GITHUB_HOST=github.example.local

